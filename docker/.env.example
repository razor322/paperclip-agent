# Copy to docker/.env (git-ignored). local-up.ps1 does this for you and fills
# in the two secrets with random values on first run.

# Required: session signing. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Independent secret for signed approval-gated tool actions.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Where the UI is reachable and which host port to bind (loopback only).
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_PORT=3100

# Persistent data (database files, workspaces, uploads, local secrets key).
# Resolved relative to the compose file in docker/.
PAPERCLIP_DATA_DIR=../data/docker-paperclip

# Published image tag to run: latest, a version like 0.42.0, or sha-<short>.
PAPERCLIP_IMAGE_TAG=latest

# Provider keys for the agent CLIs inside the container (opencode, claude, ...).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
